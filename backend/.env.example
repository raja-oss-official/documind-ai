# ============================================================
# DOCUMIND AI BACKEND SETTINGS
# Copy this file to `.env` and fill in your own values.
# Never commit the real `.env` file.
# ============================================================

# MongoDB connection and database name
MONGODB_URL=mongodb://127.0.0.1:27017
DATABASE_NAME=documind_ai

# Secret used to sign JWT access and refresh tokens.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=replace-with-a-long-random-secret

# Google Gemini API key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=replace-with-your-gemini-api-key

# Set to true only when a MongoDB Atlas vector search index is configured
VECTOR_SEARCH_ENABLED=false

# Frontend origins allowed to call the API (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional: regex for extra origins, e.g. Vercel preview deployments
# CORS_ORIGIN_REGEX=https://documind-[a-z0-9-]+-your-team\.vercel\.app
