cat > .gitignore <<'EOF'
# Secrets and environment variables
.env
.env.*
!.env.example

# Python virtual environments
.venv/
venv/
env/

# Python caches
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Test and coverage output
.coverage
htmlcov/

# User-uploaded documents and generated data
backend/uploads/*
!backend/uploads/.gitkeep
backend/test_document.txt

# Logs
*.log

# macOS
.DS_Store

# Frontend dependencies and builds
frontend/node_modules/
frontend/dist/
frontend/.astro/

# Editors
.vscode/
.idea/
EOF